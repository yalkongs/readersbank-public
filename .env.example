# ReadersBank 환경 변수 예시. 로컬에서는 이 파일을 .env.local로 복사해 값을 채운다.
# Vercel에서는 프로젝트 Settings → Environment Variables에 같은 이름으로 넣는다.

# ── 필수 ──────────────────────────────────────────────
# Postgres 연결 문자열. Vercel Marketplace에서 Neon을 연결하면 자동으로 들어간다.
DATABASE_URL=
# Vercel Blob 토큰(이미지·파일·오디오 저장). 프로젝트에 Blob 스토어를 연결하면 자동으로 들어간다.
BLOB_READ_WRITE_TOKEN=
# Anthropic API 키(번역·요약·추천 글·표지 설계). https://console.anthropic.com
ANTHROPIC_API_KEY=
# 관리 화면(/admin/login) 비밀번호.
ADMIN_PASSWORD=
# 로그인 세션 서명용 임의 문자열. 예: openssl rand -base64 32
SESSION_SECRET=

# ── 선택 ──────────────────────────────────────────────
# OpenAI API 키. 있으면 AI 표지 그림과 낭독 오디오를 만들 수 있다.
OPENAI_API_KEY=
# 낭독 목소리(기본 cedar). alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar 등.
OPENAI_TTS_VOICE=
# 웹 푸시 알림(등록 실패·번역 누락·주간 요약). 만들기: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 주간 요약 알림 cron(vercel.json) 호출 인증용 임의 문자열.
CRON_SECRET=
# 사이트 주소. 비워 두면 Vercel 운영 주소(로컬은 http://localhost:3000)를 쓴다.
SITE_URL=
# 만든 사람 표기(소개 화면 서명, 미리보기 이미지의 @핸들). 표시하지 않으려면 빈 값으로 둔다.
SITE_AUTHOR=
